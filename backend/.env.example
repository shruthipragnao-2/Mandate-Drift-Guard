APP_ENV=development
LOG_LEVEL=INFO

# Local (non-Docker) Postgres. Matches docker-compose.yml's `db` service credentials.
DATABASE_URL=postgresql+psycopg2://mandate_guard:mandate_guard@localhost:5432/mandate_guard

ANTHROPIC_API_KEY=

# Decision 17: single shared bearer token gating POST /transactions, POST /cases/{id}/resolve,
# GET /cases, and GET /cases/{id}. Must match the frontend's VITE_API_BEARER_TOKEN exactly.
API_BEARER_TOKEN=
